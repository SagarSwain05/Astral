# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB — local Docker stack or MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://astral_admin:astral_secret_2024@localhost:27017/astral_neo?authSource=admin

# Redis cache (optional — falls back to in-memory cache when unset)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# NASA API Configuration
# Get your free API key at: https://api.nasa.gov/ (DEMO_KEY is ~30 req/hour)
NASA_API_KEY=DEMO_KEY
NASA_API_BASE_URL=https://api.nasa.gov/neo/rest/v1

# CORS — comma-separated list of allowed frontend origins (enforced in production)
CORS_ORIGIN=http://localhost:3000

# Comma-separated emails promoted to the admin role on server start
ADMIN_EMAILS=

# Days to keep cached asteroid records (Mongo TTL)
CACHE_RETENTION_DAYS=30

# Requests per IP per 15 minutes on /api
RATE_LIMIT_MAX=600
