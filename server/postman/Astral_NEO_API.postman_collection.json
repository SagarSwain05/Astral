{
  "info": {
    "name": "Astral NEO Monitoring API",
    "description": "Complete API collection for the Astral Near-Earth Object Monitoring platform.\n\n## Auth Flow\n1. Register a new user via **Auth > Register**\n2. Login via **Auth > Login** \u2014 the token is auto-saved to `{{authToken}}`\n3. All private endpoints will use the saved token automatically.\n\n## Admin Routes\nRequire a user with `role: \"admin\"` \u2014 set `ADMIN_EMAILS` on the server to promote accounts on boot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "astral-neo"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "asteroidId",
      "value": "3542519"
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
